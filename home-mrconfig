[DEFAULT]
include = cat /usr/local/lib/mr/stow
lib = . /usr/local/lib/mr/mrlib


[$HOME/repos/vcs/myrepos]
order = 1
checkout = git clone git@myrepo.dmz.home.arpa:myrepos.git
update = sudo make install
fixups = git_ensure_remote upstream git://myrepos.branchable.com/myrepos

# xbps-install perl-Test-Output texinfo
[$HOME/repos/vcs/stow]
order = 2
checkout = git clone git@myrepo.dmz.home.arpa:stow.git
update =
  autoreconf -fi
  ./configure --prefix=/usr/local
  make -j4
  sudo make install
fixups = git_ensure_remote upstream git://git.savannah.gnu.org/stow.git

[$HOME/repos/wandsas/mr-config]
name = mr-config
order = 3
checkout = git clone git@myrepo.dmz.home.arpa:mr-config.git $MR_REPO
# This load repos/wandsas/mr-config/.mrconfig
chain = true
fixups = git_ensure_remote upstream git@github.com:sawander28/mr-config.git
update =
  ln -sf "$MR_REPO/home-mrconfig" ~/.mrconfig
  ln -sf "$MR_REPO/.stow-global-ignore" ~

