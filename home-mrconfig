[DEFAULT]
include = cat /usr/local/lib/mr/stow
lib = . /usr/local/lib/mr/mrlib

# =============================================================================
# Myrepos/mr
# =============================================================================

[$HOME/repos/vcs/myrepos]
order = 1
checkout = git clone git@myrepo.dmz.home.arpa:myrepos.git $MR_REPO
update = make clean && sudo make install
fixups = git_ensure_remote upstream git://myrepos.branchable.com/myrepos

[$HOME/repos/vcs/stow]
order = 2
checkout = git clone git@myrepo.dmz.home.arpa:stow.git
update = 
	 autoreconf -fi
	 ./configure --prefix=/usr/local
	 make -j4
	 sudo make install
fixups = git_ensure_remote upstream git clone --depth 289 --no-single-branch \
  https://git.savannah.gnu.org/git/stow.git
skip = true

[$HOME/repos/anon/mr-config]
name = mr-config
order = 3
checkout = git clone git@myrepo.dmz.home.arpa:mr-config.git $MR_REPO
# This chainloads ~/.config/mr/.mrconfig
chain = false
fixups = git_ensure_remote github git@github.com:sawander28/mr-config.git
update = 
	 ln -sf "$MR_REPO/home-mrconfig" ~/.mrconfig
	 ln -sf "$MR_REPO/.stow-global-ignore" ~

