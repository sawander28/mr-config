[DEFAULT]
include = cat /usr/local/lib/mr/stow
lib = . /usr/local/lib/mr/mrlib

# =============================================================================
# Myrepos/mr
# =============================================================================

[$HOME/repos/vcs/myrepos]
order = 1
checkout = git clone git@myrepo.dmz.home.arpa:myrepos.git $MR_REPO
update = make clean && sudo make install
fixups = git_ensure_remote upstream git://myrepos.branchable.com/myrepos

[$HOME/repos/anon/mr-config]
name = mr-config
order = 3
checkout = git clone git@myrepo.dmz.home.arpa:mr-config.git $MR_REPO
# This chainloads ~/.config/mr/.mrconfig
chain = false
fixups = git_ensure_remote github git@github.com:sawander28/mr-config.git
update = 
	 ln -sf "$MR_REPO/home-mrconfig" ~/.mrconfig
	 ln -sf "$MR_REPO/.stow-global-ignore" ~

# =============================================================================
# Security repos
# =============================================================================

[$HOME/.ssh]
checkout = git clone git@myrepo.dmz.home.arpa:ssh-anon.git $MR_REPO
fixups = check_privileges

[$HOME/.password-store]
checkout = git clone git@myrepo.dmz.home.arpa:pass-anon.git $MR_REPO
fixups = check_privileges

[$HOME/.gnupg]
checkout = git clone git@myrepo.dmz.home.arpa:gnupg-anon.git $MR_REPO
fixups = check_privileges

# =============================================================================
# Themes
# =============================================================================

[$HOME/.local/share/icons]
checkout = git clone git@myrepo.dmz.home.arpa:icons.git $MR_REPO

[$HOME/.local/share/themes]
checkout = git clone git@myrepo.dmz.home.arpa:themes.git $MR_REPO

[$HOME/.local/share/wallpapers]
checkout = git clone git@myrepo.dmz.home.arpa:wallpapers.git $MR_REPO

[$HOME/.local/share/fonts]
checkout = git clone git@myrepo.dmz.home.arpa:fonts.git $MR_REPO

# =============================================================================
# Shellscripts
# =============================================================================

[$HOME/repos/anon/scripts]
checkout = git clone git@myrepo.dmz.home.arpa:scripts.git $MR_REPO

[$HOME/repos/anon/admin-scripts]
checkout = git clone git@myrepo.dmz.home.arpa:admin-scripts.git $MR_REPO

# =============================================================================
# My dotfiles
# =============================================================================

[$HOME/repos/anon/mystow]
checkout = git clone 'git@myrepo.dmz.home.arpa:mystow.git' $MR_REPO
fixups = git_ensure_remote sourcehut git@git.sr.ht:~sawander/mystow
skip = true

[$HOME/.mywiki]
checkout = git clone git@myrepo.dmz.home.arpa:mywiki.git $MR_REPO

[$HOME/repos/anon/vim-config]
checkout = git clone git@myrepo.dmz.home.arpa:vim-config.git $MR_REPO
lib = MR_FOLD=
stowable = true

